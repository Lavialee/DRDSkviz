answer_info = "Tomáš Staněk v souboru dlouho fungoval jako asistent a vyzkoušel si i práci produkčního DRDS. Aktuálně působí jako mluvčí Národního divadla."

[sub_resource type="Resource" id="Resource_usvss"]
script = ExtResource("1_0oi3j")
question_text = "V roce 1946 vyrazil Dismanův soubor na bez mála deseti týdenní výpravu do Anglie, Skotska a nakonec i Holandska. Kolik představení stihl odehrát?"
