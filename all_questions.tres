correct_answer_indices = Array[int]([3])
answer_info = "Domovem letních táborů je Základna Peira, kde nás pravidelně hostí Tomáš Müller a Šárka Bečková. Oba jsou se souborem v kontaktu i během sezóny a všemi Dismančaty i vedením jsou považováni za členy souborové rodiny."

[sub_resource type="Resource" id="Resource_8xp6k"]
script = ExtResource("1_0oi3j")
question_text = "V roce 2009 odjelo na letní soustředění DRDS poprvé a naposledy pět sourozenců. O který rodinný klan se jednalo?"
