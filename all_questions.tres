answers = Array[String](["332", " 800", "153", "91"])
correct_answer_indices = Array[int]([0])
answer_info = "Broučci se uváděli na scéně pražského Intimního divadla. Z výtěžku ze vstupného se poté částečně financovala výstavba tábora, kam Dismanův soubor jel na historicky první letní soustředění."

[sub_resource type="Resource" id="Resource_06yqu"]
script = ExtResource("1_0oi3j")
question_text = "Jevištní zpracování Karafiátových Broučků bylo v podání Dismanova souboru nejčastěji k vidění na prknech jednoho pražského divadla. O kterou scénu se jednalo?"
difficulty = 1
