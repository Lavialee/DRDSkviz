[sub_resource type="Resource" id="Resource_v2mbj"]
script = ExtResource("1_0oi3j")
question_text = "Prvním divadelním představením, které Miloslav Disman se souborem nastudoval, byli Broučci Jana Karafiáta. Kolika repríz se tato inscenace dočkala?"
