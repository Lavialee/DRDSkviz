[sub_resource type="Resource" id="Resource_jdbkv"]
script = ExtResource("1_0oi3j")
question_text = "V roce 1996 vyšlo CD s názvem [i]Zobáky[/i], na kterém Dismančata spolupracovala s uznávanou českou jazzovou zpěvačkou a skladatelkou. Jak se jmenovala?"
