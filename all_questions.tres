answer_info = "Během pobytu děti bydlely u místních rodin. V rozhovoru, který najdete na našem webu, na zájezd vzpomínala tehdejší členka a choreografka Eva Zetová."

[sub_resource type="Resource" id="Resource_arsu2"]
script = ExtResource("1_0oi3j")
question_text = "Na doporučení Miloslava Dismana natočila v roce 1950 členka DRDS Zdeňka Ptáčková (později Harcubová) jeden z dialogů pro známou sérii [i]Čochtan vypravuje[/i]. Se kterým legendárním hercem tehdy dialog vedla?"
