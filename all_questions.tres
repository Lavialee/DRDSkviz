answer_info = "Jana Koubková byla též autorkou nejrůznějších rozhlasových pořadů, které se objevovaly zejména ve vysílání Vltavy."

[sub_resource type="Resource" id="Resource_nepho"]
script = ExtResource("1_0oi3j")
question_text = "Po roce 2015 uspořádal Dismanův soubor několik natáčecích výprav, které zaštiťoval věhlasný rozhlasový reportér. Kdo to byl?"
difficulty = 1
answers = Array[String](["Tomáš Černý", "Pavel Novák", "Lubomír Smatana", "Jan Pokorný"])
correct_answer_indices = Array[int]([0])
answer_info = "Tomáš Černý aktuálně působí coby dramaturg pořadu Host Lucie Výborné. Je jedním z největších znalců rozhlasové historie, což se projevuje i během natáčení. S Dismančaty točil téměř výhradně na magnetofonové pásy."

[sub_resource type="Resource" id="Resource_ar5cw"]
script = ExtResource("1_0oi3j")
question_text = "S hudebním doprovodem Miloslavu Dismanovi v souboru pomáhal stálý spolupracovník Fanda Kaplan. Se kterým z uvedených nástrojů ho děti mohly nejčastěji vidět?"
difficulty = 1
answers = Array[String](["kontrabas", "kytara", "akordeon", "housle"])
correct_answer_indices = Array[int]([2])
answer_info = "Vedle tahací harmoniky hrál Fanda Kaplan ještě na klavír. V souboru působila i jeho manželka Marie, která vedla výuku zpěvu."

[sub_resource type="Resource" id="Resource_w5dsv"]
script = ExtResource("1_0oi3j")
question_text = "Reportér roku je jediným souborovým oceněním, které má ve svém podtitulu jméno věhlasné rozhlasové osobnosti. Jak se ceně říká?"
difficulty = 1
answers = Array[String](["Cena Míly Koláře", "Cena Josefa Koláře", "Cena Františka Kocourka", "Cena Tomáše Černého"])
correct_answer_indices = Array[int]([0])
answer_info = "Bohumil Kolář byl jednou z nejvýraznějších osobností dětské a mládežnické publicistiky. V 80. letech byl coby šéf HRDM u vzniku legendárního pořadu Domino. Jeho největší vášní byl však přírodovědecký magazín [i]Meteor[/i], kam se snažil pravidelně přispívat, i když už byl zavalen šéfredaktorskými papíry."

[sub_resource type="Resource" id="Resource_li10f"]
script = ExtResource("1_0oi3j")
question_text = "Vánoční čas si žádá vánoční repertoár. Který z uvedených titulů Dismanův soubor nehrál?"
