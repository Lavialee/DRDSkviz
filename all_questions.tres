[sub_resource type="Resource" id="Resource_2ttgn"]
script = ExtResource("1_0oi3j")
question_text = "Jak se jmenuje principál umělecké skupiny [i]OLDstars[/i], kterou v roce 2002 založili absolventi DRDS, aby se mohli dále divadelně realizovat?"
