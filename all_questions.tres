[sub_resource type="Resource" id="Resource_bwfeb"]
script = ExtResource("1_0oi3j")
question_text = "V roce 2002 založili absolventi DRDS vlastní uměleckou skupinu, ve které se mohli nadále divadelně realizovat. Jak se tato skupina fungující dodnes jmenuje?"
difficulty = 1
