correct_answer_indices = Array[int]([2])
answer_info = "Broučci se dočkali celkem 332 repríz. Z výtěžku bylo zaplaceno první letní soustředění v roce 1944"

[sub_resource type="Resource" id="Resource_n0ij4"]
